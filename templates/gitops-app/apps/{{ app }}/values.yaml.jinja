# {{ app }}: what is the same in every environment (rssb-app chart). Each
# environment's envs/<env>/values.yaml adds only what differs there: the chart
# version, the host, image digests (written by CI) and per-environment settings.
# Rendered by the platform's golden path (https://github.com/{{ repository }}).

components:
{%- if backend != 'not-needed' %}
  backend:
    type: nestjs
    port: {{ backend_port }}
    secretRefs: [backend-secrets] # JWT_SECRET, ... (sealed per environment)
{%- if needs_postgres %}
    # Its own PostgreSQL role and database, <app>_<env>, created by the platform
    # (Crossplane provider-sql) from this declaration; the generated password
    # reaches the pods as DATABASE_URL. Nothing to request, nothing to seal.
    database:
      managed: true
{%- endif %}
    ingress: { enabled: true, path: /api, stripPrefix: true } # /api/users reaches the app as /users
{%- if needs_kafka %}
    # Its own Kafka user, fenced to <env>.{{ app }}.* by ACLs, and its topics,
    # created by the platform (Crossplane provider-kafka). Credentials reach the
    # pods as KAFKA_USERNAME/PASSWORD/BROKERS, the prefix as KAFKA_TOPIC_PREFIX.
    kafka:
      managed: true
      topics:
        - { name: events, partitions: 3 } # CHANGE to the topics the app produces
{%- endif %}
    env:
      NODE_ENV: production
{%- if backend_orm == 'prisma' %}
    migration:
      enabled: true # run by Argo CD before the new pods roll out
      command: [node, node_modules/prisma/build/index.js, migrate, deploy]
{%- elif backend_orm == 'typeorm' %}
    migration:
      enabled: true # run by Argo CD before the new pods roll out
      command: [node, node_modules/typeorm/cli.js, migration:run, -d, dist/data-source.js]
{%- endif %}
{%- endif %}
{%- if frontend != 'not-needed' %}

  frontend:
    type: nextjs
    port: 3000
    # Exposed on "/" by the nextjs type defaults.
{%- endif %}
{%- if worker %}

  # Background worker: the backend image with its own entry point, no port,
  # no route. Scaled on its Kafka lag by KEDA (autoscaling below).
  {{ worker }}:
    type: worker
    command: [{% for part in worker_command.split() %}{{ part }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- if needs_postgres %}
    database:
      existingSecret: backend-db # the backend's database, same DATABASE_URL
{%- endif %}
{%- if needs_kafka %}
    kafka:
      existingSecret: backend-kafka # the backend's user and prefix, same variables
{%- endif %}
    env:
      NODE_ENV: production
{%- if needs_kafka %}
    autoscaling:
      enabled: true
      metric: kafka
      minReplicas: 1
      maxReplicas: 6 # never more than the topic's partitions
      kafka:
        offsetResetPolicy: earliest
        # topic and consumerGroup: per environment (envs/<env>/values.yaml)
{%- endif %}
{%- endif %}
