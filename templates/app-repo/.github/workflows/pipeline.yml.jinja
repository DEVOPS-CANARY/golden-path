# The platform's shared pipeline (DEVOPS-CANARY/golden-path): gates on every
# PR; build, scan and deploy to UAT on develop; hotfixes to staging; promotion
# to staging and prod with the same images. Rules and docs live there.
name: Pipeline

on:
  pull_request:
    branches: [develop, staging, main]
  push:
    branches: [develop, staging, "hotfix/**"]
  workflow_dispatch: # on main: release to production

permissions:
  contents: read

concurrency:
  group: pipeline-${{ '{{' }} github.ref {{ '}}' }}
  cancel-in-progress: ${{ '{{' }} github.event_name == 'pull_request' {{ '}}' }} # superseded PR runs stop; deploys always finish

jobs:
  pipeline:
    uses: DEVOPS-CANARY/golden-path/.github/workflows/pipeline.yml@{{ pipeline_version }}
    permissions:
      contents: read
      packages: write # push images to GHCR
    with:
      app: {{ app }}
      components: '[{% set parts = [] %}{% if backend != 'none' %}{% set _ = parts.append('"backend"') %}{% endif %}{% if frontend != 'none' %}{% set _ = parts.append('"frontend"') %}{% endif %}{{ parts | join(', ') }}]'
{%- if package_manager != 'npm' %}
      package-manager: {{ package_manager }}
{%- endif %}
{%- if node_version != '22' %}
      node-version: "{{ node_version }}"
{%- endif %}
{%- if gitops_repo != 'DEVOPS-CANARY/GitOps-Repo' %}
      gitops-repo: {{ gitops_repo }}
{%- endif %}
    secrets:
      GITOPS_DEPLOY_KEY: ${{ '{{' }} secrets.GITOPS_DEPLOY_KEY {{ '}}' }}
