# syntax=docker/dockerfile:1
#
# Next.js frontend image ({{ app }}, standalone output). Rendered by the
# platform's golden path; edit freely, `copier update` shows template changes
# as a diff.
#
# Build (context is ./frontend, so docker/frontend.Dockerfile.dockerignore applies):
#   docker build -f docker/frontend.Dockerfile -t {{ app }}-frontend:dev frontend
#
# The default API base "/api" makes the image environment-agnostic: the browser
# calls its own origin and the gateway routes /api to the backend. Only local
# setups without a gateway (docker compose) override it at build time.
#
# next.config must set `output: "standalone"` and `outputFileTracingRoot`
# (platform readiness rule A1).

# Pinned by tag AND digest: the tag documents the version for humans, the digest
# guarantees the exact bytes. Renovate bumps both together.
ARG NODE_IMAGE=node:22.23.3-alpine3.24@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402
{%- if package_manager == 'yarn' %}
{%- set lockfile = 'yarn.lock' %}
{%- set cache = '/usr/local/share/.cache/yarn' %}
{%- set install = 'yarn install --frozen-lockfile' %}
{%- set build = 'yarn build' %}
{%- else %}
{%- set lockfile = 'package-lock.json' %}
{%- set cache = '/root/.npm' %}
{%- set install = 'npm ci' %}
{%- set build = 'npm run build' %}
{%- endif %}

# --- build ------------------------------------------------------------------
FROM ${NODE_IMAGE} AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
# The manifests are bind-mounted, not copied: they never become a layer, and the
# package manager's download cache lives in a BuildKit cache mount. sharing=locked:
# BuildKit runs stages in parallel and Yarn classic's cache breaks with two writers
# ("Integrity check failed", half-written tarballs); one install at a time.
RUN --mount=type=bind,source=package.json,target=package.json \
    --mount=type=bind,source={{ lockfile }},target={{ lockfile }} \
    --mount=type=cache,target={{ cache }},sharing=locked \
    {{ install }}
COPY . .
# Inlined into the browser bundle by `next build`.
ARG NEXT_PUBLIC_API_BASE_URL=/api
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
RUN {{ build }}

# --- runtime ------------------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime
# The runtime never installs packages, so drop the package managers that ship
# with the base image: less to patch (Trivy flags npm's own bundled deps) and
# nothing for an attacker to install tools with.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
    /opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg

WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    # Kubernetes sets HOSTNAME to the pod name; Next's server.js binds to it,
    # which would make the pod unreachable on other interfaces. Bind to all.
    HOSTNAME=0.0.0.0

# Standalone server + its traced node_modules, then the static assets that
# standalone deliberately leaves out. Add `COPY --link --from=build /app/public ./public`
# if the app has a public/ folder. --link: each copy is its own layer, reused
# even when earlier layers change.
COPY --link --from=build /app/.next/standalone ./
COPY --link --from=build /app/.next/static ./.next/static

# Code stays root-owned and read-only for the app user. Only Next's cache dir
# is writable (the chart mounts an emptyDir here: readOnlyRootFilesystem).
RUN mkdir -p .next/cache && chown 1000:1000 .next/cache

# Links the image to its repo in GHCR (visibility, permissions, README).
LABEL org.opencontainers.image.source="https://github.com/{{ repository }}"

# Numeric UID:GID (the image's `node` user) lets Kubernetes' runAsNonRoot
# verify the user is not root.
USER 1000:1000

EXPOSE 3000
# exec form: node is PID 1 and receives SIGTERM directly.
CMD ["node", "server.js"]
